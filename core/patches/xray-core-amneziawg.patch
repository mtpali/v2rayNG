+package wireguard
+
+import (
+ "net/netip"
+ "testing"
+)
+
+func TestAmneziaWGProfileDNSReachesNetstack(t *testing.T) {
+ conf := &DeviceConfig{DnsServers: []string{"100.64.0.1", "8.8.4.4"}}
+ servers, err := clientDNSServers(conf); if err != nil { t.Fatal(err) }
+ dev, network, _, err := CreateNetTUN([]netip.Addr{netip.MustParseAddr("100.75.120.5")}, servers, 1280, true)
+ if err != nil { t.Fatal(err) }; defer dev.Close()
+ if len(network.dnsServers) != 2 || network.dnsServers[0].String() != "100.64.0.1" { t.Fatal("tunnel resolver ignored profile DNS") }
+ defaults, err := clientDNSServers(&DeviceConfig{}); if err != nil || defaults[0].String() != "1.1.1.1" { t.Fatal("legacy resolver changed") }
+ if _, err := clientDNSServers(&DeviceConfig{DnsServers: []string{"invalid"}}); err == nil { t.Fatal("invalid resolver accepted") }
+}
