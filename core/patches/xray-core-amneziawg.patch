+)
+
+func TestAmneziaWGProfileDNSReachesNetstack(t *testing.T) {
+ conf := &DeviceConfig{DnsServers: []string{"100.64.0.1", "8.8.4.4"}}
+ servers, err := clientDNSServers(conf); if err != nil { t.Fatal(err) }
+ dev, network, _, err := CreateNetTUN([]netip.Addr{netip.MustParseAddr("100.75.120.5")}, servers, 1280, true)
+ if err != nil { t.Fatal(err) }; defer dev.Close()
+ if len(network.dnsServers) != 2 || network.dnsServers[0].String() != "100.64.0.1" { t.Fatal("tunnel resolver ignored profile DNS") }
+ defaults, err := clientDNSServers(&DeviceConfig{}); if err != nil || defaults[0].String() != "1.1.1.1" { t.Fatal("legacy resolver changed") }
+ if _, err := clientDNSServers(&DeviceConfig{DnsServers: []string{"invalid"}}); err == nil { t.Fatal("invalid resolver accepted") }
+}
diff --git a/proxy/wireguard/amnezia_handshake_test.go b/proxy/wireguard/amnezia_handshake_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..49f4755ca23085e638ad33bfeafaf6d72f2d7bf2
--- /dev/null
+++ b/proxy/wireguard/amnezia_handshake_test.go
@@ -0,0 +1,131 @@
+package wireguard
+
+import (
+	"bytes"
+	"encoding/hex"
+	"net"
+	"net/netip"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/device"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/tuntest"
+	"golang.org/x/crypto/curve25519"
+)
+
+// Signal the first blocking Read so the test deterministically applies S4
+// after the reader captured its initial offset, as can happen at app startup.
+type amneziaReadBarrier struct {
+	tun.Device
+	started chan struct{}
+	once    sync.Once
+}
+
+func (b *amneziaReadBarrier) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	b.once.Do(func() { close(b.started) })
+	return b.Device.Read(bufs, sizes, offset)
+}
+
+// Exercise a complete authenticated exchange through Xray's actual UDP bind.
+// Dummy peers use loopback sockets; no supplied keys or external server is used.
+func TestAmneziaWGProtectedHandshake(t *testing.T) {
+	for _, variant := range []string{"plain", "padding", "header", "content", "full"} {
+		t.Run(variant, func(t *testing.T) {
+			var sockets [2]net.PacketConn
+			var tunnels [2]*tuntest.ChannelTUN
+			var devices [2]*device.Device
+			var private, public [2][]byte
+			ips := [2]netip.Addr{netip.MustParseAddr("100.75.120.5"), netip.MustParseAddr("100.64.0.1")}
+			for i := range sockets {
+				var err error
+				sockets[i], err = net.ListenPacket("udp4", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				socket := sockets[i]
+				t.Cleanup(func() { socket.Close() })
+				private[i] = bytes.Repeat([]byte{byte(i + 1)}, 32)
+				public[i], err = curve25519.X25519(private[i], curve25519.Basepoint)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			for i := range devices {
+				tunnels[i] = tuntest.NewChannelTUN()
+				// Configure both peers before allowing either to initiate a handshake.
+				<-tunnels[i].TUN().Events()
+				socket := sockets[i]
+				binding := &bind{amnezia: true, listenFunc: func() (net.PacketConn, error) { return socket, nil }}
+				reader := &amneziaReadBarrier{Device: tunnels[i].TUN(), started: make(chan struct{})}
+				// Crypto workers can finish logging after Device.Close returns;
+				// do not retain a testing.T callback beyond the subtest lifetime.
+				devices[i] = device.NewDevice(reader, binding, device.NewLogger(device.LogLevelError, "AmneziaWG test: "))
+				dev := devices[i]
+				t.Cleanup(dev.Close)
+				binding.downFunc = dev.Down
+				select {
+				case <-reader.started:
+				case <-time.After(10 * time.Second):
+					t.Fatal("initial TUN read did not start")
+				}
+				options := []string{
+					"private_key=" + hex.EncodeToString(private[i]),
+					"jc=7", "jmin=10", "jmax=80",
+					"h1=1", "h2=2", "h3=3", "h4=4",
+					"i1=<b 0x" + strings.Repeat("ab", 348) + ">",
+					"i2=<b 0x" + strings.Repeat("cd", 245) + ">",
+				}
+				if variant != "plain" {
+					options = append(options, "s1=1032", "s2=532", "s3=1036", "s4=12")
+				}
+				if variant == "header" || variant == "content" || variant == "full" {
+					options = append(options, "header_protection_key=" + strings.Repeat("03", 32))
+				}
+				if variant == "content" || variant == "full" {
+					options = append(options, "content_padding_addition=10-100")
+				}
+				if variant == "full" {
+					options = append(options,
+						"rekey_after_time=100-120", "rekey_timeout=3-8",
+						"reject_after_time=150-180", "keepalive_timeout=7-13",
+						"max_handshake_attempts=15-20",
+					)
+				}
+				options = append(options,
+					"public_key=" + hex.EncodeToString(public[1-i]),
+					"preshared_key=" + strings.Repeat("04", 32),
+					"endpoint=" + sockets[1-i].LocalAddr().String(),
+					"allowed_ip=" + ips[1-i].String() + "/32",
+					"persistent_keepalive_interval=25-35",
+				)
+				if err := dev.IpcSet(strings.Join(options, "\n") + "\n"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, dev := range devices {
+				if err := dev.Up(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for i := range devices {
+				packet := tuntest.Ping(ips[1-i], ips[i])
+				select {
+				case tunnels[i].Outbound <- packet:
+				case <-time.After(10 * time.Second):
+					t.Fatal("TUN reader did not start")
+				}
+				select {
+				case received := <-tunnels[1-i].Inbound:
+					if !bytes.Equal(packet, received) {
+						t.Fatal("authenticated packet changed")
+					}
+				case <-time.After(20 * time.Second):
+					t.Fatal("authenticated packet did not arrive")
+				}
+			}
+		})
+	}
+}
