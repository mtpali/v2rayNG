index 00000000..a6047931
--- /dev/null
+++ b/infra/conf/wireguard_amnezia_runtime_test.go
@@ -0,0 +1,58 @@
+package conf_test
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	core "github.com/xtls/xray-core/core"
+	conf "github.com/xtls/xray-core/infra/conf"
+	_ "github.com/xtls/xray-core/main/distro/all"
+)
+
+func TestAmneziaWGRealWorldOutboundInitializes(t *testing.T) {
+	settings, err := json.Marshal(map[string]any{
+		"secretKey":      "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
+		"address":        []string{"10.187.192.50/30"},
+		"mtu":            1280,
+		"domainStrategy": "ForceIPv4",
+		"peers": []map[string]any{{
+			"publicKey":  "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=",
+			"endpoint":   "192.0.2.1:51820",
+			"keepAlive":  1500,
+			"allowedIPs": []string{"0.0.0.0/0", "::/0"},
+		}},
+		"amnezia": map[string]any{
+			"jc": 4, "jmin": 40, "jmax": 70,
+			"h1": "1", "h2": "2", "h3": "3", "h4": "4",
+			"i1": byteChain(348),
+			"i2": byteChain(245),
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := json.RawMessage(settings)
+	built, err := (&conf.Config{
+		OutboundConfigs: []conf.OutboundDetourConfig{{
+			Protocol: "wireguard",
+			Tag:      "proxy",
+			Settings: &raw,
+		}},
+	}).Build()
+	if err != nil {
+		t.Fatalf("failed to build real-world AmneziaWG config: %v", err)
+	}
+
+	instance, err := core.New(built)
+	if err != nil {
+		t.Fatalf("failed to initialize real-world AmneziaWG outbound: %v", err)
+	}
+	if err := instance.Close(); err != nil {
+		t.Fatalf("failed to close test instance: %v", err)
+	}
+}
+
+func byteChain(byteCount int) string {
+	return "<b 0x" + strings.Repeat("ab", byteCount) + ">"
+}
diff --git a/infra/conf/wireguard_amnezia_test.go b/infra/conf/wireguard_amnezia_test.go
new file mode 100644
index 00000000..35064be3
--- /dev/null
+++ b/infra/conf/wireguard_amnezia_test.go
@@ -0,0 +1,57 @@
+package conf
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestAmneziaWGConfigBuildIPC(t *testing.T) {
+	config := &AmneziaWGConfig{
+		Jc:                      5,
+		Jmin:                    20,
+		Jmax:                    40,
+		S1:                      64,
+		S2:                      80,
+		S3:                      96,
+		S4:                      112,
+		H1:                      "100-110",
+		I1:                      "<b 0x0102><r 8>",
+		ContentPaddingAddition:  "4-12",
+		RekeyAfterTime:          "90-120",
+		RandomizePacketTrailers: true,
+		DisableCookieReplies:    true,
+	}
+
+	ipc, err := config.BuildIPC()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, expected := range []string{
+		"jc=5\n",
+		"jmin=20\n",
+		"jmax=40\n",
+		"s4=112\n",
+		"h1=100-110\n",
+		"i1=<b 0x0102><r 8>\n",
+		"content_padding_addition=4-12\n",
+		"rekey_after_time=90-120\n",
+		"random_trailers=true\n",
+		"disable_cookies=true\n",
+	} {
+		if !strings.Contains(ipc, expected) {
+			t.Fatalf("missing %q in %q", expected, ipc)
+		}
+	}
+}
+
+func TestAmneziaWGConfigRejectsInvalidRanges(t *testing.T) {
+	for _, config := range []*AmneziaWGConfig{
+		{Jmin: 40, Jmax: 20},
+		{H1: "40-20"},
+		{S1: 65536},
+	} {
+		if _, err := config.BuildIPC(); err == nil {
+			t.Fatalf("expected invalid config to fail: %+v", config)
+		}
+	}
+}
diff --git a/proxy/wireguard/amnezia_device_test.go b/proxy/wireguard/amnezia_device_test.go
