+	ContentPaddingAddition  string `json:"contentPaddingAddition,omitempty"`
+	RekeyAfterTime          string `json:"rekeyAfterTime,omitempty"`
+	RekeyTimeout            string `json:"rekeyTimeout,omitempty"`
+	RejectAfterTime         string `json:"rejectAfterTime,omitempty"`
+	KeepaliveTimeout        string `json:"keepaliveTimeout,omitempty"`
+	MaxHandshakeAttempts    string `json:"maxHandshakeAttempts,omitempty"`
+	RandomizePacketTrailers bool   `json:"randomizePacketTrailers,omitempty"`
+	DisableCookieReplies    bool   `json:"disableCookieReplies,omitempty"`
+}
+
+func validateAmneziaRange(name, value string) error {
+	if value == "" {
+		return nil
+	}
+	var parsed awgdevice.UintRange
+	if err := parsed.FromString(value); err != nil {
+		return errors.New("invalid AmneziaWG ", name, ": ", value).Base(err)
+	}
+	return nil
+}
+
+func validateAmneziaChain(name, value string) error {
+	if strings.ContainsAny(value, "\r\n") {
+		return errors.New("invalid newline in AmneziaWG ", name)
+	}
+	return nil
+}
+
+func parseAmneziaKey(key string) (string, error) {
+	if key == "" {
+		return "", nil
+	}
+	if decoded, err := hex.DecodeString(key); err == nil && len(decoded) == 32 {
+		return strings.ToLower(key), nil
+	}
+	decoded, err := base64.StdEncoding.DecodeString(key)
+	if err != nil || len(decoded) != 32 {
+		return "", errors.New("invalid AmneziaWG header protection key")
+	}
+	return hex.EncodeToString(decoded), nil
+}
+
+func (c *AmneziaWGConfig) BuildIPC() (string, error) {
+	if c == nil {
+		return "", nil
+	}
+	if c.Jmax != 0 && c.Jmin > c.Jmax {
+		return "", errors.New("AmneziaWG jmin must not be greater than jmax")
+	}
+	for name, value := range map[string]uint32{
+		"s1": c.S1, "s2": c.S2, "s3": c.S3, "s4": c.S4,
+	} {
+		if value > 1<<16-1 {
+			return "", errors.New("AmneziaWG ", name, " must not exceed 65535")
+		}
+	}
+	for name, value := range map[string]string{
+		"h1": c.H1, "h2": c.H2, "h3": c.H3, "h4": c.H4,
+		"contentPaddingAddition": c.ContentPaddingAddition,
+		"rekeyAfterTime":         c.RekeyAfterTime,
+		"rekeyTimeout":           c.RekeyTimeout,
+		"rejectAfterTime":        c.RejectAfterTime,
+		"keepaliveTimeout":       c.KeepaliveTimeout,
+		"maxHandshakeAttempts":   c.MaxHandshakeAttempts,
+	} {
+		if err := validateAmneziaRange(name, value); err != nil {
+			return "", err
+		}
+	}
+	for name, value := range map[string]string{
+		"i1": c.I1, "i2": c.I2, "i3": c.I3, "i4": c.I4, "i5": c.I5,
+	} {
+		if err := validateAmneziaChain(name, value); err != nil {
+			return "", err
+		}
+	}
+	headerKey, err := parseAmneziaKey(c.HeaderProtectionKey)
+	if err != nil {
+		return "", err
+	}
+	if headerKey != "" && (c.S1 < 12 || c.S2 < 12 || c.S3 < 12 || c.S4 < 12) {
+		return "", errors.New("AmneziaWG header protection requires s1-s4 to be at least 12")
+	}
+
+	var request strings.Builder
+	writeUint := func(name string, value uint32) {
+		if value != 0 {
+			fmt.Fprintf(&request, "%s=%d\n", name, value)
+		}
+	}
+	writeString := func(name, value string) {
+		if value != "" {
+			fmt.Fprintf(&request, "%s=%s\n", name, value)
+		}
+	}
+	writeUint("jc", c.Jc)
+	writeUint("jmin", c.Jmin)
+	writeUint("jmax", c.Jmax)
+	writeUint("s1", c.S1)
+	writeUint("s2", c.S2)
+	writeUint("s3", c.S3)
+	writeUint("s4", c.S4)
+	writeString("h1", c.H1)
+	writeString("h2", c.H2)
+	writeString("h3", c.H3)
+	writeString("h4", c.H4)
+	writeString("i1", c.I1)
+	writeString("i2", c.I2)
+	writeString("i3", c.I3)
+	writeString("i4", c.I4)
+	writeString("i5", c.I5)
+	writeString("header_protection_key", headerKey)
+	writeString("content_padding_addition", c.ContentPaddingAddition)
+	writeString("rekey_after_time", c.RekeyAfterTime)
+	writeString("rekey_timeout", c.RekeyTimeout)
+	writeString("reject_after_time", c.RejectAfterTime)
+	writeString("keepalive_timeout", c.KeepaliveTimeout)
+	writeString("max_handshake_attempts", c.MaxHandshakeAttempts)
+	if c.RandomizePacketTrailers {
+		request.WriteString("random_trailers=true\n")
+	}
+	if c.DisableCookieReplies {
+		request.WriteString("disable_cookies=true\n")
+	}
+	return request.String(), nil
