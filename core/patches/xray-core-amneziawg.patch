+package wireguard
+
+import (
+	"strings"
+	"testing"
+
+	awgconn "github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	awgdevice "github.com/amnezia-vpn/amneziawg-go/v3/device"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/tuntest"
+)
+
+func TestAmneziaWGDeviceAcceptsRealWorldLongInitPackets(t *testing.T) {
+	tunDevice := tuntest.NewChannelTUN()
+	device := awgdevice.NewDevice(
+		tunDevice.TUN(),
+		awgconn.NewDefaultBind(),
+		awgdevice.NewLogger(awgdevice.LogLevelError, ""),
+	)
+	defer device.Close()
+
+	configuration := strings.Join([]string{
+		"private_key=" + strings.Repeat("01", 32),
+		"jc=4",
+		"jmin=40",
+		"jmax=70",
+		"h1=1",
+		"h2=2",
+		"h3=3",
+		"h4=4",
+		"s1=1032",
+		"s2=532",
+		"s3=1036",
+		"s4=12",
+		"header_protection_key=" + strings.Repeat("03", 32),
+		"content_padding_addition=10-100",
+		"rekey_after_time=100-120",
+		"rekey_timeout=3-8",
+		"reject_after_time=150-180",
+		"keepalive_timeout=7-13",
+		"max_handshake_attempts=15-20",
+		"i1=" + realWorldByteChain(348),
+		"i2=" + realWorldByteChain(245),
+		"public_key=" + strings.Repeat("02", 32),
+		"endpoint=192.0.2.1:51820",
+		"allowed_ip=0.0.0.0/0",
+		"allowed_ip=::/0",
+		"persistent_keepalive_interval=25-35",
+	}, "\n") + "\n"
+
+	if err := device.IpcSet(configuration); err != nil {
+		t.Fatalf("AmneziaWG device rejected real-world option sizes: %v", err)
+	}
+}
+
+func realWorldByteChain(byteCount int) string {
+	return "<b 0x" + strings.Repeat("ab", byteCount) + ">"
+}
