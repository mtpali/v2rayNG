+
+// AmneziaWGConfig contains the device-level options implemented by
+// amneziawg-go. String values preserve AWG 3 range syntax (for example,
+// "30-45") until they are passed to the device UAPI.
+type AmneziaWGConfig struct {
+	Jc                      uint32 `json:"jc,omitempty"`
+	Jmin                    uint32 `json:"jmin,omitempty"`
+	Jmax                    uint32 `json:"jmax,omitempty"`
+	S1                      uint32 `json:"s1,omitempty"`
+	S2                      uint32 `json:"s2,omitempty"`
+	S3                      uint32 `json:"s3,omitempty"`
+	S4                      uint32 `json:"s4,omitempty"`
+	H1                      string `json:"h1,omitempty"`
+	H2                      string `json:"h2,omitempty"`
+	H3                      string `json:"h3,omitempty"`
+	H4                      string `json:"h4,omitempty"`
+	I1                      string `json:"i1,omitempty"`
+	I2                      string `json:"i2,omitempty"`
+	I3                      string `json:"i3,omitempty"`
+	I4                      string `json:"i4,omitempty"`
+	I5                      string `json:"i5,omitempty"`
