@@ -0,0 +1,58 @@
+package conf_test
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	core "github.com/xtls/xray-core/core"
+	conf "github.com/xtls/xray-core/infra/conf"
+	_ "github.com/xtls/xray-core/main/distro/all"
+)
+
+func TestAmneziaWGRealWorldOutboundInitializes(t *testing.T) {
+	settings, err := json.Marshal(map[string]any{
+		"secretKey":      "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
+		"address":        []string{"10.187.192.50/30"},
+		"mtu":            1280,
+		"domainStrategy": "ForceIPv4",
+		"peers": []map[string]any{{
+			"publicKey":  "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=",
+			"endpoint":   "192.0.2.1:51820",
+			"keepAlive":  1500,
+			"allowedIPs": []string{"0.0.0.0/0", "::/0"},
+		}},
+		"amnezia": map[string]any{
+			"jc": 4, "jmin": 40, "jmax": 70,
+			"h1": "1", "h2": "2", "h3": "3", "h4": "4",
+			"i1": byteChain(348),
+			"i2": byteChain(245),
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := json.RawMessage(settings)
+	built, err := (&conf.Config{
+		OutboundConfigs: []conf.OutboundDetourConfig{{
+			Protocol: "wireguard",
+			Tag:      "proxy",
+			Settings: &raw,
+		}},
+	}).Build()
+	if err != nil {
+		t.Fatalf("failed to build real-world AmneziaWG config: %v", err)
+	}
+
+	instance, err := core.New(built)
+	if err != nil {
+		t.Fatalf("failed to initialize real-world AmneziaWG outbound: %v", err)
+	}
+	if err := instance.Close(); err != nil {
+		t.Fatalf("failed to close test instance: %v", err)
+	}
+}
+
+func byteChain(byteCount int) string {
+	return "<b 0x" + strings.Repeat("ab", byteCount) + ">"
+}
