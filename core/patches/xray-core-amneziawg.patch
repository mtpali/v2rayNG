@@ -0,0 +1,85 @@
+package conf
+
+import (
+	"strings"
+	"testing"
+ "reflect"
+ "github.com/xtls/xray-core/proxy/wireguard"
+ "google.golang.org/protobuf/proto"
+)
+
+func TestAmneziaWGConfigBuildIPC(t *testing.T) {
+	config := &AmneziaWGConfig{
+		Jc:                      5,
+		Jmin:                    20,
+		Jmax:                    40,
+		S1:                      64,
+		S2:                      80,
+		S3:                      96,
+		S4:                      112,
+		H1:                      "100-110",
+		I1:                      "<b 0x0102><r 8>",
+		ContentPaddingAddition:  "4-12",
+		RekeyAfterTime:          "90-120",
+		RandomizePacketTrailers: true,
+		DisableCookieReplies:    true,
+	}
+
+	ipc, err := config.BuildIPC()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, expected := range []string{
+		"jc=5\n",
+		"jmin=20\n",
+		"jmax=40\n",
+		"s4=112\n",
+		"h1=100-110\n",
+		"i1=<b 0x0102><r 8>\n",
+		"content_padding_addition=4-12\n",
+		"rekey_after_time=90-120\n",
+		"random_trailers=true\n",
+		"disable_cookies=true\n",
+	} {
+		if !strings.Contains(ipc, expected) {
+			t.Fatalf("missing %q in %q", expected, ipc)
+		}
+	}
+}
+
+func TestAmneziaWGConfigRejectsInvalidRanges(t *testing.T) {
+	for _, config := range []*AmneziaWGConfig{
+		{Jmin: 40, Jmax: 20},
+		{H1: "40-20"},
+		{S1: 65536},
+	} {
+		if _, err := config.BuildIPC(); err == nil {
+			t.Fatalf("expected invalid config to fail: %+v", config)
+		}
+	}
+}
+
+func TestAmneziaWGKeepaliveRange(t *testing.T) {
+ for _, value := range []string{"25-35", "25"} {
+  peer, err := (&WireGuardPeerConfig{KeepAliveRange: value}).Build()
+  if err != nil { t.Fatal(err) }
+  if peer.KeepAlive != value { t.Fatalf("keepalive lost: %q", peer.KeepAlive) }
+ }
+ if _, err := (&WireGuardPeerConfig{KeepAliveRange:"35-25"}).Build(); err == nil { t.Fatal("reversed range accepted") }
+ peer, err := (&WireGuardPeerConfig{KeepAlive:25}).Build()
+ if err != nil || peer.KeepAlive != "25" { t.Fatal("legacy numeric keepalive changed") }
+}
+
+func TestAmneziaWGDNSProtoRoundTrip(t *testing.T) {
+ c := &WireGuardConfig{SecretKey: strings.Repeat("01",32), DnsServers: []string{"100.64.0.1", "8.8.4.4"}}
+ config, err := c.Build(); if err != nil { t.Fatal(err) }
+ data, err := proto.Marshal(config); if err != nil { t.Fatal(err) }
+ var restored wireguard.DeviceConfig
+ if err := proto.Unmarshal(data, &restored); err != nil { t.Fatal(err) }
+ if !reflect.DeepEqual(c.DnsServers, restored.DnsServers) { t.Fatal("profile DNS lost in protobuf bridge") }
+ c.DnsServers = []string{"invalid.example"}
+ if _, err := c.Build(); err == nil { t.Fatal("non-IP resolver accepted") }
+ c.DnsServers = nil
+ legacy, err := c.Build(); if err != nil { t.Fatal(err) }
+ if len(legacy.(*wireguard.DeviceConfig).DnsServers) != 0 { t.Fatal("legacy config gained DNS") }
+}
